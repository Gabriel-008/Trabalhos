include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "CSVParser.h"
 
#define READ_BUF_SIZE 8192
#define NUM_CONTINENTES 6
 
typedef struct {
    char continent[32];
    float userData[2];  
} ContinentData;
 
ContinentData continents[NUM_CONTINENTES] = { 
    {"Africa",        {0, 0}},
    {"Asia",          {0, 0}},
    {"Europe",        {0, 0}},
    {"North America", {0, 0}},
    {"South America", {0, 0}},
    {"Oceania",       {0, 0}}
};
 
int encontrarContinente(char* name) { 
    for (int i = 0; i < NUM_CONTINENTES; i++)
        if (strcmp(name, continents[i].continent) == 0)
            return i;
    return -1;
}
 
void callback(char** cols, int ncols, void* userData) {
    ContinentData* continents = (ContinentData*) userData;
 
    /*
        cols[1] = continent
        cols[5] = new_cases
        cols[8] = new_deaths
    */
 
    if (ncols <= 8)
        return;
 
    char* continent = cols[1];
 
    if (continent[0] == '\0' || strcmp(continent, "continent") == 0)
        return;
 
    int cont = encontrarContinente(continent);
    if (cont == -1)
        return;
 
    if (cols[5][0] != '\0')
        continents[cont].userData[0] += atof(cols[5]);
 
    if (cols[8][0] != '\0')
        continents[cont].userData[1] += atof(cols[8]);
}
 
int main() {
    char* buf = (char*) malloc(READ_BUF_SIZE);
    CSVParser csv;
    CSVParser_init(&csv);
 
    FILE* f = fopen("./owid-covid-data.csv", "rb");
    if (f) {
        int leu = fread(buf, 1, READ_BUF_SIZE, f);
        while (leu > 0) {
            CSVParser_processLines(&csv, buf, leu, callback, continents);
            leu = fread(buf, 1, READ_BUF_SIZE, f);
        }
        }else{
            fprintf(stderr, "\nErro, o arquivo não pôde ser aberto");
            return 1;
        } 
        fclose(f);
        CSVParser_processLines(&csv, "\n", 1, callback, continents);
 
        printf("\n Casos e mortes por continente pela covid-19\n");
        for (int i = 0; i < NUM_CONTINENTES; i++) {
            printf("%s\nCasos: %.0f\nMortes: %.0f\n\n",continents[i].continent, continents[i].userData[0],continents[i].userData[1]);
        }
 
    free(buf);
    return 0;
